{
    "tabWidth": 4,
    "useTabs": false,
    "singleQuote": true,
    "semi": false,
    "bracketSpacing": true,
    "arrowParens": "avoid",
    "trailingComma": "none",
    "bracketSameLine": true,
    "printWidth": 120,
    "endOfLine": "lf",
    "plugins": ["prettier-plugin-css-order", "prettier-plugin-organize-imports"],
    "cssDeclarationSorterOrder": "alphabetical"
}
