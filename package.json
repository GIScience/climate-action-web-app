{
  "name": "climate-action-app",
  "version": "1.2.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --host=127.0.0.1",
    "dev": "ng serve --proxy-config proxy.conf.json",
    "build": "ng build",
    "build:prod": "ng build --configuration production --base-href /webapp/",
    "build:staging": "ng build --configuration staging --base-href /webapp/",
    "build:dev": "ng build --configuration development --base-href /webapp/",
    "build:int": "ng build --configuration integration",
    "build:stats": "ng build --stats-json",
    "analyze": "webpack-bundle-analyzer dist/stats.json",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --code-coverage --no-progress --browsers=Chrome --watch=false",
    "test-chromium-headless": "ng test --browsers=ChromiumHeadless --watch=false",
    "cy:open": "cypress open",
    "cy:run": "cypress run --headless --browser chrome",
    "test:all": "npm run test && npm run cy:run",
    "lint": "ng lint --max-warnings 0",
    "lint:fix": "ng lint --fix"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^17.3.11",
    "@angular/cdk": "^17.3.10",
    "@angular/common": "^17.3.11",
    "@angular/compiler": "^17.3.11",
    "@angular/core": "^17.3.11",
    "@angular/forms": "^17.3.11",
    "@angular/material": "^17.3.10",
    "@angular/material-moment-adapter": "^17.3.10",
    "@angular/platform-browser": "^17.3.11",
    "@angular/platform-browser-dynamic": "^17.3.11",
    "@angular/router": "^17.3.11",
    "@ngneat/helipopper": "^10.2.0-alpha.0",
    "@ngx-formly/core": "^6.2.1",
    "@ngx-formly/material": "^6.0.0",
    "@types/ol": "^7.0.0",
    "brand-colors": "^2.1.1",
    "chart.js": "^4.4.3",
    "cypress-visual-regression": "^5.2.2",
    "dayjs": "^1.11.9",
    "geojson-vt": "^4.0.2",
    "lodash": "^4.17.21",
    "lucide-angular": "^0.439.0",
    "marked": "^12.0.2",
    "material-icons-font": "^2.1.0",
    "moment": "^2.29.1",
    "ng2-charts": "^5.0.4",
    "ngx-markdown": "^17.2.1",
    "ngx-papaparse": "^8.0.0",
    "ngx-scrollbar": "^16.0.0",
    "ol": "^9.2.4",
    "ol-ext": "^4.0.23",
    "plotly.js-basic-dist-min": "^2.24.2",
    "plotly.js-geo-dist": "^2.24.3",
    "remarkable": "^2.0.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.14.7"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^17.3.8",
    "@angular-eslint/builder": "17.5.2",
    "@angular-eslint/eslint-plugin": "17.5.2",
    "@angular-eslint/eslint-plugin-template": "17.5.2",
    "@angular-eslint/schematics": "17.5.2",
    "@angular-eslint/template-parser": "17.5.2",
    "@angular/cli": "~17.3.8",
    "@angular/compiler-cli": "^17.3.11",
    "@ngx-formly/schematics": "^6.2.1",
    "@stylistic/eslint-plugin": "^1.4.1",
    "@stylistic/eslint-plugin-ts": "^1.4.1",
    "@types/jasmine": "~4.3.0",
    "@types/ol-ext": "npm:@siedlerchr/types-ol-ext@^3.5.0",
    "@types/plotly.js-basic-dist-min": "^2.12.1",
    "@types/remarkable": "^2.0.8",
    "@typescript-eslint/eslint-plugin": "^7.2.0",
    "@typescript-eslint/parser": "^7.2.0",
    "cypress": "^13.11.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.0.0",
    "jasmine-core": "~4.5.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.1.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.0.0",
    "typescript": "~5.4.5",
    "webpack-bundle-analyzer": "^4.9.0"
  }
}
