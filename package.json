{
    "name": "climate-action-navigator",
    "version": "3.7.0",
    "scripts": {
        "ng": "ng",
        "start": "ng serve --no-hmr --host=127.0.0.1",
        "dev": "ng serve --proxy-config proxy.conf.json",
        "build:prod": "ng build --configuration production --base-href /",
        "build:dev": "ng build --configuration development --base-href /",
        "build:stats": "ng build --stats-json",
        "analyze": "pnpm dlx esbuild-visualizer --metadata ./dist/stats.json --open",
        "watch": "ng build --watch --configuration development",
        "test": "jest",
        "test:watch": "jest --watch --onlyChanged",
        "test:coverage": "jest --coverage",
        "test-chromium-headless": "jest",
        "cy:open": "cypress open",
        "cy:run": "cypress run --headless --browser chrome",
        "cy:run:all": "cypress run --headless --browser chrome --expose failFastEnabled=false --config retries=0",
        "test:all": "pnpm run test && pnpm run cy:run",
        "lint": "ng lint --max-warnings 0",
        "lint:fix": "ng lint --fix",
        "prepare": "husky"
    },
    "private": true,
    "lint-staged": {
        "*.{ts,js,html,scss,css,json,md,yml,yaml}": "prettier --write"
    },
    "dependencies": {
        "@angular/animations": "^21.2.15",
        "@angular/cdk": "^21.2.13",
        "@angular/common": "^21.2.15",
        "@angular/compiler": "^21.2.15",
        "@angular/core": "^21.2.15",
        "@angular/forms": "^21.2.15",
        "@angular/material": "^21.2.13",
        "@angular/material-date-fns-adapter": "^21.2.13",
        "@angular/platform-browser": "^21.2.15",
        "@angular/platform-browser-dynamic": "^21.2.15",
        "@angular/router": "^21.2.15",
        "@geomatico/maplibre-cog-protocol": "^0.9.0",
        "@jsverse/transloco": "8.4.0",
        "@jsverse/transloco-messageformat": "^8.0.2",
        "@mapbox/mapbox-gl-rtl-text": "^0.4.0",
        "@ngneat/helipopper": "^13.0.0",
        "@ngx-formly/core": "^7.0.0",
        "@ngx-formly/material": "^7.0.0",
        "@tmcw/togeojson": "^7.1.2",
        "@turf/area": "^7.2.0",
        "@turf/bbox": "^7.3.4",
        "@turf/buffer": "^7.3.5",
        "@turf/distance": "^7.3.4",
        "@turf/mask": "^7.3.1",
        "@versatiles/style": "^5.9.4",
        "@watergis/maplibre-gl-terradraw": "^1.4.0",
        "@xmldom/xmldom": "^0.9.10",
        "appwrite": "~24.0.0",
        "chart.js": "4.5.0",
        "date-fns": "^4.1.0",
        "driver.js": "^1.3.5",
        "geotiff": "^3.0.0",
        "jspdf": "^4.0.0",
        "lucide-angular": "^1.0.0",
        "maplibre-gl": "^6.0.0",
        "maplibre-ui-translations": "^0.4.0",
        "material-icons-font": "^2.1.0",
        "ng2-charts": "^9.0.0",
        "ngx-markdown": "20.1.0",
        "ngx-papaparse": "^8.0.0",
        "ngx-scrollbar": "^19.0.0",
        "ngx-toastr": "^20.0.0",
        "plotly.js-locales": "3.7.0",
        "plotly.js-strict-dist": "^3.0.1",
        "pmtiles": "^4.3.0",
        "polyclip-ts": "^0.16.8",
        "remarkable": "^2.0.1",
        "rxjs": "~7.8.0",
        "tslib": "^2.3.0",
        "zone.js": "~0.16.0"
    },
    "devDependencies": {
        "@angular-eslint/builder": "^21.0.0",
        "@angular-eslint/eslint-plugin": "^21.0.0",
        "@angular-eslint/eslint-plugin-template": "^21.0.0",
        "@angular-eslint/schematics": "^21.0.0",
        "@angular-eslint/template-parser": "^21.0.0",
        "@angular/build": "^21.2.13",
        "@angular/cli": "~21.2.13",
        "@angular/compiler-cli": "^21.2.15",
        "@jest/globals": "^30.0.5",
        "@ngx-formly/schematics": "^7.0.0",
        "@stylistic/eslint-plugin": "^5.0.0",
        "@stylistic/eslint-plugin-ts": "^4.4.1",
        "@types/geojson": "^7946.0.16",
        "@types/jest": "^30.0.0",
        "@types/json-schema": "^7.0.15",
        "@types/node": "^24.1.0",
        "@types/remarkable": "^2.0.8",
        "@typescript-eslint/eslint-plugin": "^8.33.1",
        "@typescript-eslint/parser": "^8.33.1",
        "cypress": "^15.0.0",
        "cypress-fail-fast": "^8.1.0",
        "cypress-file-upload": "^5.0.8",
        "cypress-real-events": "^1.14.0",
        "cypress-visual-regression": "^6.0.0",
        "eslint": "^9.28.0",
        "eslint-config-prettier": "^10.0.0",
        "html2canvas": "^1.4.1",
        "husky": "^9.1.7",
        "jest": "^30.0.0",
        "jest-environment-jsdom": "^30.2.0",
        "jest-preset-angular": "^17.0.0",
        "json-schema": "^0.4.0",
        "lint-staged": "^17.0.0",
        "lmdb": "^3.4.1",
        "prettier": "^3.4.2",
        "prettier-plugin-css-order": "^2.1.2",
        "prettier-plugin-organize-imports": "^4.1.0",
        "sass": "^1.83.4",
        "tippy.js": "^6.3.7",
        "ts-node": "^10.9.2",
        "typescript": "5.9.3",
        "wait-on": "^9.0.5"
    },
    "overrides": {
        "rollup": "npm:@rollup/wasm-node"
    }
}
