{
  "name": "climate-action-app",
  "version": "0.1.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "dev": "ng serve --proxy-config proxy.conf.json",
    "build": "ng build",
    "build:prod": "ng build --configuration production --base-href /webapp/",
    "build:staging": "ng build --configuration staging --base-href /webapp/",
    "build:dev": "ng build --configuration development --base-href /webapp/",
    "build:int": "ng build --configuration integration",
    "build:stats": "ng build --stats-json",
    "analyze": "webpack-bundle-analyzer dist/stats.json",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --code-coverage",
    "test-chromium-headless": "ng test --browsers=ChromiumHeadless --watch=false",
    "lint": "ng lint",
    "lint:fix": "ng lint --fix"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^16.2.1",
    "@angular/cdk": "^16.2.11",
    "@angular/common": "^16.2.1",
    "@angular/compiler": "^16.2.1",
    "@angular/core": "^16.2.1",
    "@angular/forms": "^16.2.1",
    "@angular/material": "^16.2.11",
    "@angular/material-moment-adapter": "^16.2.12",
    "@angular/platform-browser": "^16.2.1",
    "@angular/platform-browser-dynamic": "^16.2.1",
    "@angular/router": "^16.2.1",
    "@ngx-formly/core": "^6.2.1",
    "@ngx-formly/material": "^6.0.0",
    "@taiga-ui/addon-charts": "^3.75.0",
    "@taiga-ui/addon-mobile": "^3.75.0",
    "@taiga-ui/addon-preview": "^3.75.0",
    "@taiga-ui/addon-table": "^3.75.0",
    "@taiga-ui/cdk": "^3.75.0",
    "@taiga-ui/core": "^3.75.0",
    "@taiga-ui/icons": "^3.75.0",
    "@taiga-ui/kit": "^3.75.0",
    "@taiga-ui/layout": "^3.75.0",
    "@taiga-ui/styles": "^3.75.0",
    "@tinkoff/ng-dompurify": "4.0.0",
    "@types/ol": "^7.0.0",
    "brand-colors": "^2.1.1",
    "chart.js": "^3.9.1",
    "dayjs": "^1.11.9",
    "dompurify": "3.0.6",
    "lodash": "^4.17.21",
    "marked": "^4.3.0",
    "moment": "^2.29.1",
    "ng2-charts": "^5.0.3",
    "ngx-markdown": "^16.0.0",
    "ngx-papaparse": "^8.0.0",
    "ol": "^8.1.0",
    "perfect-scrollbar": "^1.5.5",
    "plotly.js-basic-dist-min": "^2.24.2",
    "plotly.js-geo-dist": "^2.24.3",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.13.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^16.2.0",
    "@angular-eslint/builder": "16.1.1",
    "@angular-eslint/eslint-plugin": "16.1.1",
    "@angular-eslint/eslint-plugin-template": "16.1.1",
    "@angular-eslint/schematics": "16.1.1",
    "@angular-eslint/template-parser": "16.1.1",
    "@angular/cli": "~16.2.0",
    "@angular/compiler-cli": "^16.2.1",
    "@ngx-formly/schematics": "^6.2.1",
    "@stylistic/eslint-plugin": "^1.4.1",
    "@stylistic/eslint-plugin-ts": "^1.4.1",
    "@types/dompurify": "3.0.5",
    "@types/jasmine": "~4.3.0",
    "@types/plotly.js-basic-dist-min": "^2.12.1",
    "@typescript-eslint/eslint-plugin": "5.62.0",
    "@typescript-eslint/parser": "5.62.0",
    "eslint": "^8.47.0",
    "eslint-config-prettier": "^9.0.0",
    "jasmine-core": "~4.5.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.1.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.0.0",
    "typescript": "~4.9.4",
    "webpack-bundle-analyzer": "^4.9.0"
  }
}
