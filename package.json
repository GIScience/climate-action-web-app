        "jest-preset-angular": "^16.0.0",
        "json-schema": "^0.4.0",
        "lmdb": "^3.4.1",
        "prettier": "^3.4.2",
        "prettier-plugin-css-order": "^2.1.2",
        "sass": "^1.83.4",
        "tippy.js": "^6.3.7",
        "typescript": "5.9.3",
        "wait-on": "^9.0.0"
    },
    "overrides": {
        "rollup": "npm:@rollup/wasm-node"
    }
}
